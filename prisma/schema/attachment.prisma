model Attachment {
  id           String   @id @default(uuid())
  requestId    String
  uploadedById String
  url          String
  publicId     String
  createdAt    DateTime @default(now())

  request    ServiceRequest @relation(fields: [requestId], references: [id])
  uploadedBy User           @relation(fields: [uploadedById], references: [id])

  @@index([requestId])
}